package components

templ ThemeSwitcher() {
	<div
		class="theme-switcher"
		data-signals="{
      themes: ['light', 'dark', 'system']
    }"
	>
		<label>Theme</label>
		<button
			data-on:click="
        $theme = $themes[($themes.indexOf($theme) + 1) % $themes.length];
        localStorage.setItem('theme', $theme);
        document.documentElement.className = $theme === 'system' ? '' : $theme;
      "
			data-text="$theme"
			class="theme-button"
		></button>
	</div>
}
